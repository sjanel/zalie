# Script mode helper of EmbedFiles.cmake: cmake -D INPUT=<file> -D OUTPUT=<cpp> -D SYMBOL=<name> -P EmbedFile.cmake

file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" hex_length)
math(EXPR size "${hex_length} / 2")

# 0xAB, every byte; then break lines every 32 bytes to keep the generated file readable by tools.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")

if(size EQUAL 0)
  set(bytes "0x00")
endif()

file(
  WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/EmbedFile.cmake from ${INPUT} - do not edit.\n"
  "#include <cstddef>\n#include <span>\n\n"
  "namespace zalie::embedded {\n"
  "std::span<const unsigned char> ${SYMBOL}() noexcept;\n\n"
  "namespace {\nalignas(16) constexpr unsigned char kData[] = {\n${bytes}\n};\n}  // namespace\n\n"
  "std::span<const unsigned char> ${SYMBOL}() noexcept { return {kData, ${size}U}; }\n\n"
  "}  // namespace zalie::embedded\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
